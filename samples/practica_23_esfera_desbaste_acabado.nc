O2301 (PRACTICA 23 - DESBASTE Y ACABADO DE MEDIA ESFERA)
G17 G21 G90 G94 G40 G49 G69 G80

(1. DESBASTE DEL MATERIAL ALREDEDOR)
T10 M06
M03 S4500
G54
G43 H10 G00 Z10.0
#120 = 52.0
N20
G00 X#120 Y0.0
G01 Z-30.0 F180 M08
G17
G03 I[-#120] J0.0 F500
G00 Z5.0
#120 = [#120 - 5.0]
IF [#120 GE 37.0] GOTO 20
G00 Z15.0
M09

(2. ACABADO ESFERICO CON PUNTA BOLA)
T36 M06
M03 S6000
G43 H36 G00 Z15.0
#100 = 0.0      (ANGULO DEL PERFIL)
#101 = 30.0     (RADIO DE LA ESFERA)
#102 = 3.0      (RADIO DE LA HERRAMIENTA)
#103 = [#101 + #102]
#104 = [-#101 - #102]
#105 = [#103 * COS[#100]]
#106 = [#104 + #103 * SIN[#100]]
G00 X#105 Y0.0
G01 Z#106 F180 M08

N100
G17
G03 I[-#105] J0.0 F350
#100 = [#100 + 5.0]
IF [#100 GT 85.0] GOTO 200
#107 = [#103 * COS[#100]]
#108 = [#104 + #103 * SIN[#100]]
G18
G03 X#107 Z#108 I[-#105] K[#104 - #106] F180
#105 = #107
#106 = #108
GOTO 100

N200
G18
G03 X0.0 Z0.0 I[-#105] K[#104 - #106] F180
G17
G00 Z15.0
M05 M09
G91 G28 Z0.0
G90
M30
