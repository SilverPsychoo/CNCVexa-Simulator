O2303 (PRACTICA 23 - ESFERA CENTRADA CON PISO DE 2 MM)
G17 G21 G90 G94 G40 G49 G69 G80

(1. DESBASTE EXTERIOR HASTA Z-28, DEJANDO PISO DE 2 MM)
T10 M06
M03 S4500
G54
G43 H10 G00 Z10.0
M08

#120 = 0.0      (PROFUNDIDAD ACTUAL)
N20
#120 = [#120 - 4.0]
IF [#120 LT -28.0] THEN #120 = -28.0

#121 = -5.0     (BARRIDO FUERA DE LA PARED INFERIOR)
N30
#122 = [#121 - 50.0]
#123 = ABS[#122]

IF [#123 GE 33.0] GOTO 50

#124 = SQRT[1089.0 - #122 * #122]
#125 = [50.0 - #124]
#126 = [50.0 + #124]

(RECORTE IZQUIERDO HASTA FUERA DE LA PARED)
G00 X-5.0 Y#121 Z5.0
G01 Z#120 F180
G01 X#125 F500
G00 Z5.0

(RECORTE DERECHO HASTA FUERA DE LA PARED)
G00 X#126 Y#121
G01 Z#120 F180
G01 X105.0 F500
G00 Z5.0
GOTO 60

N50
(BARRIDO COMPLETO DE PARED A PARED)
G00 X-5.0 Y#121 Z5.0
G01 Z#120 F180
G01 X105.0 F500
G00 Z5.0

N60
#121 = [#121 + 5.0]
IF [#121 LE 105.0] GOTO 30
IF [#120 GT -28.0] GOTO 20

G00 Z15.0
M09

(2. ACABADO DE LA ESFERA CENTRADA EN X50 Y50)
T36 M06
M03 S6000
G43 H36 G00 Z15.0
M08

#100 = 6.0      (INICIA ARRIBA DEL PISO PARA NO ATRAVESARLO)
#101 = 28.0     (RADIO DE LA ESFERA)
#102 = 3.0      (RADIO DE LA FRESA DE PUNTA BOLA)
#103 = [#101 + #102]
#104 = [-#101 - #102]
#105 = [#103 * COS[#100]]
#106 = [#104 + #103 * SIN[#100]]

G00 X[50.0 + #105] Y50.0
G01 Z#106 F180

N100
G17
G03 I[-#105] J0.0 F350

#100 = [#100 + 4.0]
IF [#100 GT 86.0] GOTO 200

#107 = [#103 * COS[#100]]
#108 = [#104 + #103 * SIN[#100]]

G18
G03 X[50.0 + #107] Z#108 I[-#105] K[#104 - #106] F180

#105 = #107
#106 = #108
GOTO 100

N200
G18
G03 X50.0 Z0.0 I[-#105] K[#104 - #106] F180
G17
G00 Z15.0
M05 M09
G91 G28 Z0.0
G90
M30
