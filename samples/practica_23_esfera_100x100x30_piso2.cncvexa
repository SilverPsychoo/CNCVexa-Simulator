  "name": "practica_23_esfera_100x100x30_piso2.nc",
  "code": "O2303 (PRACTICA 23 - ESFERA CENTRADA CON PISO DE 2 MM)\nG17 G21 G90 G94 G40 G49 G69 G80\n\n(1. DESBASTE EXTERIOR HASTA Z-28, DEJANDO PISO DE 2 MM)\nT10 M06\nM03 S4500\nG54\nG43 H10 G00 Z10.0\nM08\n\n#120 = 0.0      (PROFUNDIDAD ACTUAL)\nN20\n#120 = [#120 - 4.0]\nIF [#120 LT -28.0] THEN #120 = -28.0\n\n#121 = -5.0     (BARRIDO FUERA DE LA PARED INFERIOR)\nN30\n#122 = [#121 - 50.0]\n#123 = ABS[#122]\n\nIF [#123 GE 33.0] GOTO 50\n\n#124 = SQRT[1089.0 - #122 * #122]\n#125 = [50.0 - #124]\n#126 = [50.0 + #124]\n\n(RECORTE IZQUIERDO HASTA FUERA DE LA PARED)\nG00 X-5.0 Y#121 Z5.0\nG01 Z#120 F180\nG01 X#125 F500\nG00 Z5.0\n\n(RECORTE DERECHO HASTA FUERA DE LA PARED)\nG00 X#126 Y#121\nG01 Z#120 F180\nG01 X105.0 F500\nG00 Z5.0\nGOTO 60\n\nN50\n(BARRIDO COMPLETO DE PARED A PARED)\nG00 X-5.0 Y#121 Z5.0\nG01 Z#120 F180\nG01 X105.0 F500\nG00 Z5.0\n\nN60\n#121 = [#121 + 5.0]\nIF [#121 LE 105.0] GOTO 30\nIF [#120 GT -28.0] GOTO 20\n\nG00 Z15.0\nM09\n\n(2. ACABADO DE LA ESFERA CENTRADA EN X50 Y50)\nT36 M06\nM03 S6000\nG43 H36 G00 Z15.0\nM08\n\n#100 = 6.0      (INICIA ARRIBA DEL PISO PARA NO ATRAVESARLO)\n#101 = 28.0     (RADIO DE LA ESFERA)\n#102 = 3.0      (RADIO DE LA FRESA DE PUNTA BOLA)\n#103 = [#101 + #102]\n#104 = [-#101 - #102]\n#105 = [#103 * COS[#100]]\n#106 = [#104 + #103 * SIN[#100]]\n\nG00 X[50.0 + #105] Y50.0\nG01 Z#106 F180\n\nN100\nG17\nG03 I[-#105] J0.0 F350\n\n#100 = [#100 + 4.0]\nIF [#100 GT 86.0] GOTO 200\n\n#107 = [#103 * COS[#100]]\n#108 = [#104 + #103 * SIN[#100]]\n\nG18\nG03 X[50.0 + #107] Z#108 I[-#105] K[#104 - #106] F180\n\n#105 = #107\n#106 = #108\nGOTO 100\n\nN200\nG18\nG03 X50.0 Z0.0 I[-#105] K[#104 - #106] F180\nG17\nG00 Z15.0\nM05 M09\nG91 G28 Z0.0\nG90\nM30\n",
